{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "16704236516204051734"
    }
  },
  "parameters": {
    "alertEmail": {
      "type": "string",
      "metadata": {
        "description": "Email that receives down alerts."
      }
    },
    "siteUrl": {
      "type": "string",
      "defaultValue": "https://camdjackson.com/",
      "metadata": {
        "description": "Public URL to monitor (end-to-end)."
      }
    },
    "contentMatch": {
      "type": "string",
      "defaultValue": "Cameron Jackson",
      "metadata": {
        "description": "Text that must be present on the page (guards against 200-but-broken)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "aiName": "ai-camdjackson",
    "testName": "avail-camdjackson"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('aiName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "Request_Source": "rest"
      }
    },
    {
      "type": "Microsoft.Insights/webtests",
      "apiVersion": "2022-06-15",
      "name": "[variables('testName')]",
      "location": "[parameters('location')]",
      "tags": {
        "[format('hidden-link:{0}', resourceId('Microsoft.Insights/components', variables('aiName')))]": "Resource"
      },
      "kind": "standard",
      "properties": {
        "SyntheticMonitorId": "[variables('testName')]",
        "Name": "camdjackson.com availability",
        "Enabled": true,
        "Frequency": 300,
        "Timeout": 30,
        "Kind": "standard",
        "RetryEnabled": true,
        "Locations": [
          {
            "Id": "us-ca-sjc-azr"
          },
          {
            "Id": "us-tx-sn1-azr"
          },
          {
            "Id": "us-il-ch1-azr"
          },
          {
            "Id": "us-va-ash-azr"
          },
          {
            "Id": "us-fl-mia-edge"
          }
        ],
        "Request": {
          "RequestUrl": "[parameters('siteUrl')]",
          "HttpVerb": "GET",
          "ParseDependentRequests": false
        },
        "ValidationRules": {
          "ExpectedHttpStatusCode": 200,
          "SSLCheck": true,
          "SSLCertRemainingLifetimeCheck": 7,
          "ContentValidation": {
            "ContentMatch": "[parameters('contentMatch')]",
            "IgnoreCase": true,
            "PassIfTextFound": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('aiName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "ag-camdjackson-down",
      "location": "global",
      "properties": {
        "groupShortName": "sitedown",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "owner",
            "emailAddress": "[parameters('alertEmail')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "alert-camdjackson-down",
      "location": "global",
      "properties": {
        "description": "camdjackson.com is failing its availability test",
        "severity": 1,
        "enabled": true,
        "scopes": [
          "[resourceId('Microsoft.Insights/webtests', variables('testName'))]",
          "[resourceId('Microsoft.Insights/components', variables('aiName'))]"
        ],
        "evaluationFrequency": "PT1M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.WebtestLocationAvailabilityCriteria",
          "webTestId": "[resourceId('Microsoft.Insights/webtests', variables('testName'))]",
          "componentId": "[resourceId('Microsoft.Insights/components', variables('aiName'))]",
          "failedLocationCount": 2
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', 'ag-camdjackson-down')]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', 'ag-camdjackson-down')]",
        "[resourceId('Microsoft.Insights/components', variables('aiName'))]",
        "[resourceId('Microsoft.Insights/webtests', variables('testName'))]"
      ]
    }
  ]
}