# ============================================================================
# terraform.tfvars.example, COPY to terraform.tfvars and fill in.
# ============================================================================
#   cp terraform.tfvars.example terraform.tfvars   # then edit
#
# terraform.tfvars is GITIGNORED, the two passwords are real secrets. Each
# must be >= 12 chars with upper, lower, digit, and symbol (Azure rejects weak
# ones). Rotate / tear down after the shoot.
#
# yourname MUST match the AWS side. location should sit near your AWS region.

yourname                   = "cam"
location                   = "East US"
appliance_admin_password   = "ChangeMe-Appl1ance!"
replication_admin_password = "ChangeMe-Repl1cation!"
